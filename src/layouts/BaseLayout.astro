---
// src/layouts/BaseLayout.astro
// Wraps every page — edit head tags, fonts, CDN scripts here
const { title = 'Muathaf — Cloud & AI Engineer', description = 'Cloud & AI Engineer. Dual MS in AI & IT. Relocating GCC 2026.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta property="og:title"       content={title}/>
  <meta property="og:description" content={description}/>
  <meta name="theme-color"        content="#050810"/>

  <!-- Fonts (non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap"
        media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap">
  </noscript>

  <!-- Splitting CSS -->
  <link rel="stylesheet" href="https://unpkg.com/splitting/dist/splitting.css">
</head>
<body>
  <!-- Custom cursor -->
  <div id="c-dot"></div>
  <div id="c-ring"></div>

  <slot />

  <!-- CDN Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"          is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
  <script src="https://unpkg.com/splitting/dist/splitting.min.js"                        is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"             is:inline></script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
