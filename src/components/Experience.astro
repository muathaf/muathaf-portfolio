---
// src/components/Experience.astro
const jobs = [
  {
    period: '2023 – 2024',
    type: 'Contract · USA',
    role: 'Linux System Admin Support',
    company: 'Freelance / Contract',
    desc: 'Supported Linux server environments across multiple machines. Handled monitoring, incident triage, Bash automation, and system maintenance. Built scripts for log analysis and alerting used in real production environments.',
  },
  {
    period: '2022 – 2025',
    type: 'Freelance · USA',
    role: 'IT & E-commerce Operations',
    company: 'Remote Gigs',
    desc: 'Managed digital storefronts, inventory systems, and operations support for small businesses. Built and maintained web presences, handled data reporting and tech support across multiple clients simultaneously.',
  },
  {
    period: '2021 – 2022',
    type: 'Full Time · USA',
    role: 'Operations & Coordinator',
    company: 'Commercial Operations',
    desc: 'Self-funded dual master\'s degrees through operational and cash management roles. Developed reliability, composure under pressure, and cross-functional support skills that translate directly into production engineering.',
  },
];
---

<section id="experience" class="section">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-tag">04</span>
      <h2 class="sec-title" data-splitting>Experience</h2>
      <div class="sec-divider"></div>
    </div>

    <div class="timeline">
      {jobs.map((job) => (
        <div class="tl" data-reveal>
          <div class="tl-dot"></div>
          <div class="tl-when">
            <div class="tl-period">{job.period}</div>
            <div class="tl-type">{job.type}</div>
          </div>
          <div>
            <div class="tl-role">{job.role}</div>
            <div class="tl-co">{job.company}</div>
            <div class="tl-desc">{job.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.section {
  padding: 6rem 2rem;
  border-top: 1px solid var(--rule);
}

.sec-head {
  display: flex;
  align-items: flex-end;
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.sec-tag {
  font-family: var(--ff-m);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--blue);
  letter-spacing: 0.1em;
}

.sec-title {
  font-family: var(--ff-d);
  font-size: 2.8rem;
  font-weight: 800;
  color: var(--text);
  margin: 0;
}

.sec-divider {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--bline), transparent);
}

.timeline { display: flex; flex-direction: column; gap: 2.5rem; }
.tl { display: grid; grid-template-columns: auto 1fr 1fr; gap: 2rem; align-items: start; position: relative; }
.tl-dot { width: 14px; height: 14px; background: var(--blue); border-radius: 50%; border: 3px solid var(--bg); position: absolute; left: -22px; top: 8px; }
.tl::before { content: ''; position: absolute; left: -15px; top: 30px; width: 1px; height: calc(100% + 2.5rem); background: var(--bline); }
.tl:last-child::before { display: none; }

.tl-when { }
.tl-period { font-family: var(--ff-m); font-size: 1rem; font-weight: 600; color: var(--blue); margin-bottom: 0.3rem; }
.tl-type { font-family: var(--ff-m); font-size: 0.85rem; color: var(--muted); letter-spacing: 0.05em; }

.tl-role { font-family: var(--ff-d); font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: 0.3rem; }
.tl-co { font-family: var(--ff-m); font-size: 0.9rem; color: var(--mid); margin-bottom: 1rem; }
.tl-desc { font-size: 0.95rem; color: var(--mid); line-height: 1.8; }

@media (max-width: 768px) {
  .section {
    padding: 4rem 1.5rem;
  }
  
  .sec-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .sec-divider {
    width: 60px;
  }
  
  .sec-title {
    font-size: 2rem;
  }
  
  .tl {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .tl-dot {
    left: -18px;
    top: 4px;
  }
}
</style>