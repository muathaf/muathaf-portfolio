---
// src/components/Ticker.astro
// Edit keywords here — they loop infinitely
const items = [
  'Cloud Infrastructure', 'Systems Administration', 'DevOps Engineer',
  'Terraform & AWS', 'Kubernetes',
  'Python · Bash · Linux', 'Production Ready',
];
// Duplicate for seamless loop
const all = [...items, ...items];
---

<div class="ticker">
  <div class="ticker-track">
    {all.map(item => (
      <span class="ti"><b>✦</b>{item}</span>
    ))}
  </div>
</div>