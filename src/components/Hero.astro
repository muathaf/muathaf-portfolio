---
// src/components/Hero.astro
---

<section id="hero">
  <div class="hero-inner">
    <div class="hero-tag">Cloud Infrastructure Engineer</div>
    
    <h1 class="hero-name">MUATHAF</h1>
    
    <p class="hero-desc">
      Dual master's degrees in Information Technology and Artificial Intelligence. I build and maintain cloud infrastructure that works in production. AWS, Terraform, Kubernetes, Linux, Python, CI/CD.
    </p>

    <div class="hero-cta">
      <a href="#projects" class="btn-primary">View My Work</a>
      <div class="hero-badge">Open to Relocate Immediately</div>
    </div>
  </div>
</section>

<style>
#hero {
  padding: 3rem 1.5rem 2.5rem;
  display: flex;
  align-items: center;
}

.hero-inner {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.hero-tag {
  font-family: 'DM Mono', monospace;
  font-size: 0.75rem;
  color: #00d9ff;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1rem;
  opacity: 0.9;
}

.hero-name {
  font-family: 'Syne', sans-serif;
  font-size: 2rem;
  font-weight: 800;
  color: #f8fafc;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  letter-spacing: -0.03em;
}

.hero-desc {
  font-size: 0.95rem;
  color: #cbd5e1;
  line-height: 1.8;
  margin-bottom: 1.5rem;
  max-width: 650px;
}

.hero-cta {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #00d9ff, #0099ff);
  color: #0a0e27;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.9rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: 'DM Sans', sans-serif;
  white-space: nowrap;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0, 217, 255, 0.3);
}

.hero-badge {
  font-family: 'DM Mono', monospace;
  font-size: 0.75rem;
  padding: 0.4rem 0.9rem;
  border: 1px solid rgba(0, 217, 255, 0.3);
  border-radius: 20px;
  color: #00d9ff;
  background: rgba(0, 217, 255, 0.08);
  letter-spacing: 0.05em;
  white-space: nowrap;
}

@media (min-width: 768px) {
  #hero {
    padding: 4rem 2rem 3rem;
  }

  .hero-tag {
    font-size: 0.85rem;
    margin-bottom: 1.2rem;
  }

  .hero-name {
    font-size: 3rem;
    margin-bottom: 1.8rem;
  }

  .hero-desc {
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .btn-primary {
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
  }

  .hero-badge {
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
  }
}

@media (min-width: 1024px) {
  #hero {
    padding: 6rem 3rem 4rem;
    min-height: 60vh;
  }

  .hero-name {
    font-size: 3.8rem;
    margin-bottom: 2rem;
  }

  .hero-desc {
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }
}
</style>