---
// src/components/Hero.astro
---

<section id="hero">
  <div class="wrap">
    <div class="hero-content">
      <div class="hero-tag">Cloud Infrastructure Engineer</div>
      
      <h1 class="hero-name">MUATHAF</h1>
      
      <p class="hero-desc">
        Dual master's degrees in Information Technology and Artificial Intelligence. I build and maintain cloud infrastructure that works in production. AWS, Terraform, Kubernetes, Linux, Python, CI/CD.
      </p>

      <div class="hero-cta">
        <a href="#projects" class="btn-primary">View My Work</a>
        <div class="hero-badge">Open to Relocate Immediately</div>
      </div>
    </div>
  </div>
</section>

<style>
#hero {
  padding: 6rem 2rem 4rem;
  min-height: 60vh;
  display: flex;
  align-items: center;
  position: relative;
}

.wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
  width: 100%;
}

.hero-content {
  max-width: 680px;
}

.hero-tag {
  font-family: 'DM Mono', monospace;
  font-size: 0.9rem;
  color: #00d9ff;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.hero-name {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.5rem, 8vw, 3.8rem);
  font-weight: 800;
  color: #f8fafc;
  line-height: 1;
  margin-bottom: 2rem;
  letter-spacing: -0.03em;
}

.hero-desc {
  font-size: 1.05rem;
  color: #cbd5e1;
  line-height: 1.8;
  margin-bottom: 2.5rem;
  max-width: 600px;
}

.hero-cta {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-block;
  padding: 0.85rem 2rem;
  background: linear-gradient(135deg, #00d9ff, #0099ff);
  color: #0a0e27;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: 'DM Sans', sans-serif;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0, 217, 255, 0.3);
}

.hero-badge {
  font-family: 'DM Mono', monospace;
  font-size: 0.8rem;
  padding: 0.5rem 1rem;
  border: 1px solid rgba(0, 217, 255, 0.3);
  border-radius: 20px;
  color: #00d9ff;
  background: rgba(0, 217, 255, 0.08);
  letter-spacing: 0.05em;
  white-space: nowrap;
}

@media (max-width: 768px) {
  #hero {
    padding: 4rem 1.5rem 3rem;
    min-height: 50vh;
  }

  .hero-name {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .hero-desc {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .hero-cta {
    gap: 1rem;
  }

  .btn-primary {
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
  }
}
</style>