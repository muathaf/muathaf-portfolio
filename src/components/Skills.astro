---
// src/components/Skills.astro
// Add/edit skill categories and pills here
const skills = [
  {
    num: '01',
    icon: '☁️',
    title: 'Cloud & DevOps',
    pills: ['AWS EC2/S3', 'Docker', 'Linux SysAdmin', 'Bash', 'Git', 'CI/CD', 'GitHub Actions'],
  },
  {
    num: '02',
    icon: '🤖',
    title: 'AI & Data',
    pills: ['Python', 'PostgreSQL', 'Data Modeling', 'Machine Learning', 'RapidMiner', 'RStudio', 'FastAPI'],
  },
  {
    num: '03',
    icon: '⚙️',
    title: 'IT & Operations',
    pills: ['Server Maintenance', 'Jira', 'Shopify', 'HTML/CSS', 'Troubleshooting', 'Log Analysis'],
  },
];
---

<section id="skills">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-tag">02</span>
      <h2 class="sec-title" data-splitting>Skills</h2>
      <div class="sec-divider"></div>
    </div>
    <div class="skills-grid">
      {skills.map(sk => (
        <div class="sk" data-reveal>
          <div class="sk-topline"></div>
          <div class="sk-num">{sk.num} / 03</div>
          <div class="sk-head">
            <div class="sk-icon">{sk.icon}</div>
            <div class="sk-title">{sk.title}</div>
          </div>
          <div class="pills">
            {sk.pills.map(p => <span class="pill">{p}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
#skills { background: var(--bg); border-top: 1px solid var(--rule); }
.skills-grid {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 1px; background: var(--rule); border: 1px solid var(--rule);
}
.sk { background: var(--bg1); padding: 2.4rem; position: relative; overflow: hidden; transition: background .3s; }
.sk:hover { background: var(--bg2); }
.sk-topline {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, var(--blue), var(--blue3), transparent);
  transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease);
}
.sk:hover .sk-topline { transform: scaleX(1); }
.sk-num   { font-family: var(--ff-m); font-size: .6rem; color: var(--muted); letter-spacing: .12em; margin-bottom: 1.4rem; opacity: .6; }
.sk-head  { display: flex; align-items: center; gap: .85rem; margin-bottom: 1.6rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--rule); }
.sk-icon  { width: 36px; height: 36px; background: var(--dim); border: 1px solid var(--bline); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
.sk-title { font-family: var(--ff-d); font-size: 1rem; font-weight: 700; color: var(--text); }
.sk:hover .pill { color: var(--blue); border-color: var(--bline); background: var(--dim); }

@media(max-width:1080px) and (min-width:641px) { .skills-grid { grid-template-columns: 1fr 1fr; } }
@media(max-width:640px)                         { .skills-grid { grid-template-columns: 1fr; } }
</style>
