---
// src/components/Skills.astro
---

<section id="skills" class="section">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-tag">02</span>
      <h2 class="sec-title" data-splitting>Skills</h2>
      <div class="sec-divider"></div>
    </div>
    
    <div class="skills-grid">
      <div class="skill-category">
        <h3>☁️ Cloud Infrastructure</h3>
        <div class="skills-list">
          AWS EC2 · AWS S3 · AWS EKS · Terraform · VPC · IAM · CloudWatch · Production Architecture
        </div>
      </div>
      
      <div class="skill-category">
        <h3>🐧 Systems Administration</h3>
        <div class="skills-list">
          Linux · Bash · Server Management · Monitoring · Log Analysis · Incident Response · Production Support
        </div>
      </div>
      
      <div class="skill-category">
        <h3>🐳 Containers & DevOps</h3>
        <div class="skills-list">
          Docker · Kubernetes · GitHub Actions · CI/CD Pipelines · Infrastructure as Code
        </div>
      </div>
      
      <div class="skill-category">
        <h3>📊 Data & Analysis</h3>
        <div class="skills-list">
          Python · Pandas · SQL · PostgreSQL · Data Pipelines · ETL
        </div>
      </div>
      
      <div class="skill-category">
        <h3>🛠️ Tools & Languages</h3>
        <div class="skills-list">
          Python · Bash · Git · GitHub · VS Code · Terminal
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.section {
  padding: 6rem 2rem;
  border-top: 1px solid var(--rule);
}

.sec-head {
  display: flex;
  align-items: flex-end;
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.sec-tag {
  font-family: var(--ff-m);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--blue);
  letter-spacing: 0.1em;
}

.sec-title {
  font-family: var(--ff-d);
  font-size: 2.8rem;
  font-weight: 800;
  color: var(--text);
  margin: 0;
}

.sec-divider {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--bline), transparent);
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
}

.skill-category {
  padding: 2rem;
  border: 1px solid var(--rule);
  border-radius: 8px;
  background: rgba(56, 189, 248, 0.02);
}

.skill-category h3 {
  font-family: var(--ff-d);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.skills-list {
  font-size: 0.95rem;
  color: var(--mid);
  line-height: 1.8;
}

@media (max-width: 768px) {
  .section {
    padding: 4rem 1.5rem;
  }
  
  .sec-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .sec-divider {
    width: 60px;
  }
  
  .sec-title {
    font-size: 2rem;
  }
  
  .skills-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>